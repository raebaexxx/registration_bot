# Токен бота из @BotFather
BOT_TOKEN=123456789:AA...

# Telegram ID админов через запятую (узнать свой ID можно в @userinfobot)
ADMIN_IDS=123456789

# ID канала для анонсов. Для приватного канала: -1001234567890
# Бот должен быть администратором канала с правом публикации сообщений.
CHANNEL_ID=-1001234567890

# Часовой пояс для дат, времени игр и напоминаний
TZ=Europe/Moscow

# Путь к базе. В Docker оставьте как есть.
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Сколько минут действует предложение места из листа ожидания
WAITLIST_OFFER_MINUTES=120

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
